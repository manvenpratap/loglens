{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "LogLens - Analysis Workflow",
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "output": "workflow.html"
  },
  "lanes": [
    { "id": "user", "label": "User Actions" },
    { "id": "ingest", "label": "Ingestion & Decompression" },
    { "id": "parse", "label": "Worker Parsing Pool" },
    { "id": "render", "label": "Visualization & State" }
  ],
  "phases": [
    { "id": "phase_input", "label": "1. Ingest", "fromCol": 0, "toCol": 1 },
    { "id": "phase_process", "label": "2. Match & Parse", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "phase_visualize", "label": "3. Explore", "fromCol": 4, "toCol": 5 }
  ],
  "groups": [
    { "id": "worker_group", "label": "Worker Concurrency", "lane": "parse", "fromCol": 2, "toCol": 3, "variant": "emphasis" }
  ],
  "mainPath": ["drop_file", "stream_unzip", "distribute_chunks", "regex_tokenize", "build_tree", "render_timeline"],
  "nodes": [
    { "id": "drop_file", "lane": "user", "col": 0, "type": "external", "label": "Drop Log File", "sublabel": "raw .log or .gz", "width": 140 },
    { "id": "stream_unzip", "lane": "ingest", "col": 1, "type": "frontend", "label": "Decompress Stream", "sublabel": "in-browser pako", "width": 140 },
    { "id": "distribute_chunks", "lane": "ingest", "col": 2, "type": "backend", "label": "Chunk Slicer", "sublabel": "split into buffers", "width": 140 },
    { "id": "regex_tokenize", "lane": "parse", "col": 3, "type": "backend", "label": "Worker Regex Match", "sublabel": "parallel tokenization", "tag": "workers", "width": 140 },
    { "id": "build_tree", "lane": "render", "col": 4, "type": "database", "label": "Hierarchy Assembler", "sublabel": "tree correlation", "width": 140 },
    { "id": "render_timeline", "lane": "render", "col": 5, "type": "frontend", "label": "Interactive Views", "sublabel": "Gantt, Tree, 3D", "tag": "canvas", "width": 140 }
  ],
  "edges": [
    { "id": "e1", "from": "drop_file", "to": "stream_unzip", "variant": "emphasis" },
    { "id": "e2", "from": "stream_unzip", "to": "distribute_chunks", "variant": "default" },
    { "id": "e3", "from": "distribute_chunks", "to": "regex_tokenize", "label": "transfer buffer", "variant": "emphasis" },
    { "id": "e4", "from": "regex_tokenize", "to": "build_tree", "label": "parsed events", "variant": "emphasis" },
    { "id": "e5", "from": "build_tree", "to": "render_timeline", "label": "update views", "variant": "emphasis" }
  ],
  "cards": [
    { "dot": "cyan", "title": "Zero Wait UI", "items": ["Chunk slicing prevents main thread UI freezes", "Incremental rendering displays initial lines immediately"] }
  ]
}
